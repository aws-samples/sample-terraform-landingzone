# Account IDs for cross-account deployment
# Copy this file to accounts.hcl and fill in after accounts are created:
#   cp env/accounts.hcl.example env/accounts.hcl
#
# After `terragrunt apply` on the accounts stack, get IDs with:
#   cd stacks/management/accounts && terragrunt output account_ids

locals {
  # Empty: the stacks read it from the organization unit. Required when
  # enable_organization = false and the finding consumers run in the Audit
  # account (without it audit/security-org-config enrols no management account).
  management_account_id  = ""
  audit_account_id       = ""
  log_archive_account_id = ""
  deployment_account_id  = ""

  # Keys are account NAMES as declared in env/common.hcl (accounts[].name),
  # e.g. "Workload-Dev" — NOT the stack directory name ("workload-dev").
  # Both consumers read this map with the same key form: the workload
  # sidecars (stacks/workload-dev/*/cross_account.hcl) and the OU membership
  # resolution (configurations/ou-membership.hcl).
  #
  #   workload_accounts = {
  #     "Workload-Dev" = "111111111111"
  #   }
  workload_accounts = {}
}
