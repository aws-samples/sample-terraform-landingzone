# =============================================================================
# Terraform Landing Zone — .gitignore
# =============================================================================

# --- Terraform Core ---

.terraform/
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
crash.log
crash.*.log
*.tfplan
*tfplan*
planout
.terraformrc
terraform.rc

# --- Sensitive files ---

# tfvars can contain passwords, emails, account IDs
# EXCEPTION: profiles/ are committed (reference configurations)
*.tfvars
*.tfvars.json
!configurations/*/*.tfvars

# Override files (local adjustments)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# --- Terragrunt ---

# LEGACY local-backend state location. State now lives OUTSIDE the repo
# ($TLZ_STATE_DIR, default ~/.tlz-state) — precisely because a gitignored
# in-repo directory is what `git clean -xfd` deletes, live state included.
# This entry stays so a not-yet-migrated tree cannot accidentally COMMIT
# live state; it does NOT protect that state from clean. Migrate first:
# docs/operations.md, "Migrating local state out of the repository".
/.state/

**/.terragrunt-cache/
stacks/**/backend.tf
stacks/**/provider.tf
stacks/**/versions.tf
# Generated by the config-recorder-members unit (no terraform source block —
# generate blocks write into the unit directory itself). providers.tf and
# config_recorders.tf carry real account IDs and role ARNs.
stacks/**/providers.tf
stacks/**/config_recorders.tf
stacks/**/member_roles.tf
stacks/**/outputs.tf
stacks/**/adoption-imports.tf
stacks/**/.terraform.lock.hcl
stacks/**/.terraform/

# Account IDs and local configuration (contains real AWS account IDs and emails)
env/accounts.hcl
env/common.hcl
!env/common.hcl.example
!env/accounts.hcl.example

# --- Python ---

__pycache__/
*.pyc
.hypothesis/
.pytest_cache/
# Hand-off H2 (P4 · logging-and-live-tooling): per-run junitxml artifact of the
# live probes — pass/fail is a property of a run, not of the repository.
tests/live/.probe-results.xml

# --- IDE and editor ---

.vscode/
*.code-workspace
.idea/
*.iml
*.swp
*.swo
*~
\#*\#
.\#*

# --- Tool caches (local) ---

.checkov/
.checkov_cache/
.tflint.d/
.infracost/
# pinned scanners (bandit 1.8.6, gitleaks 8.30.1) installed by `make tools-probe`
/.tools/

# --- CI/CD (local) ---

.github/
.gitlab-ci-local/

# --- OS ---

.DS_Store
.AppleDouble
.LSOverride
._*
.directory
Thumbs.db
ehthumbs.db
Desktop.ini

# --- Secrets and credentials ---

*.pem
*.key
*.crt
*.p12
credentials
credentials.json
saml-metadata.xml
.env
.env.*
!.env.example

# --- Docker (local) ---

docker-compose.override.yml

# --- External export (make publish-export, tools/publish/) ---

/.publish-export/
.publish-build-*/
.publish-old-*/

# --- Gap Analysis Reports (internal only) ---

GAP-ANALYSIS-*.md

# --- Temporary files ---

tmp/
temp/
*.tmp
*.bak
*.orig
*.log
logs/
*.dot
*.svg
!docs/diagrams/icons/*.svg
graph.png

# --- Lambda archive files (generated by data.archive_file) ---

**/.archive/
# archive_file output of the configuration-supplied Config-rule functions
# (modules/config-rules/lambda-functions.tf): derived at plan/test time from
# committed source, never a distribution artifact.
**/lambda-packages/*.zip
# archive_file output of the module-shipped function sources
# (modules/monitoring/main.tf packages lambda/log_group_onboarding.py to
# lambda/log_group_onboarding.zip): same class, the .py stays versioned.
**/lambda/*.zip

# --- Scripts (local teardown/cleanup helpers) ---

scripts/

# AWS Integration Test Harness — all artifacts are git-excluded
/.integration/*
!/.integration/README.template.md

# --- Live test harness (local, per-host artifacts) ---

# Real account allowlist and generated readiness report stay local; only the
# .example with placeholder IDs is versioned.
tests/live/accounts.allowlist.json
tests/live/readiness-report.md

# Prior-state capture written by tools/live/assert_prior_state.sh before a
# RECORDED restricted run (the state that run is about to change, plus the
# commands that restore it). Per host, per account, per module: describes one
# real account at one moment, so it is never versioned.
tests/live/.prior-state-*.txt

# Run-scoped staging dir for layer-4 module apply-tests (livetest-modules
# copies tests/live/modules/<m>/ here for the run and removes it after).
modules/*/.livetest/

# Mass-provisioning study (tests/live/mass_provisioning/): the operator
# config carries the owner's real root-e-mail scheme, the ledger carries the
# real account IDs of the throwaway accounts — both stay local;
# only env/massprov.json.example with a placeholder scheme is versioned.
env/massprov.json
env/massprov/

# The real AWS account number for a session's credentials; only aws.env.example is versioned.
aws.env
aws.env.*
!aws.env.example
