# =============================================================================
# Break-glass access package
# =============================================================================
# Emergency console access for the management account: a small, numbered set
# of IAM users behind enable_break_glass (default false — without the switch
# nothing is created). Each user carries the mandatory permissions boundary,
# AdministratorAccess within that boundary, and a console login profile whose
# initial password lands in Secrets Manager and must be changed at first
# sign-in. The matching usage alarm lives in modules/monitoring
# (break-glass-alarm.tf) and reads the same user prefix from the CloudTrail
# log group.
#
# Boundaries, stated plainly:
#   * The initial console password is generated by the provider and therefore
#     stands in the Terraform state as well as in Secrets Manager.
#     password_reset_required forces a rotation at first sign-in, which
#     retires the state copy. This is the same state boundary the existing
#     auto_generate_password path carries.
#   * Access keys are deliberately not created — break-glass is console
#     access; long-lived API credentials would widen the surface without
#     need.
#   * MFA cannot be enrolled by Terraform. Register the devices right after
#     deployment (README, section Break-glass access).
#   * SCPs do not bind the management account, so the quarantine SCP needs no
#     exemption for these users.

locals {
  # "prefix-01" … "prefix-NN" — a stable, numbered set: shrinking user_count
  # removes the highest numbers first, growing it appends.
  break_glass_users = var.enable_break_glass ? {
    for i in range(var.break_glass_config.user_count) :
    format("%s-%02d", var.break_glass_config.user_prefix, i + 1) => i + 1
  } : {}
}

resource "aws_iam_user" "break_glass" {
  for_each = local.break_glass_users

  name                 = each.key
  permissions_boundary = var.break_glass_config.permissions_boundary
}

# AdministratorAccess within the mandatory boundary: the boundary caps what
# the emergency session may do; the attached policy grants everything inside
# that cap. The direct user attachment is the deliberate break-glass surface
# already documented for iam_users.
resource "aws_iam_user_policy_attachment" "break_glass_admin" {
  for_each = local.break_glass_users

  user       = aws_iam_user.break_glass[each.key].name
  policy_arn = "${local.arn_prefix}:iam::aws:policy/AdministratorAccess"
}

resource "aws_iam_user_login_profile" "break_glass" {
  for_each = local.break_glass_users

  user                    = aws_iam_user.break_glass[each.key].name
  password_reset_required = true
}

# The generated initial password, retrievable by the operator without reading
# the state: one secret per user in the deployment region, encrypted with the
# optional customer-managed key or the Secrets Manager service key.
resource "aws_secretsmanager_secret" "break_glass_password" {
  for_each = local.break_glass_users

  name        = "tlz/break-glass/${each.key}/password"
  description = "Initial console password for break-glass user ${each.key} (reset required at first sign-in)"
  kms_key_id  = var.secrets_kms_key_arn != "" ? var.secrets_kms_key_arn : null
}

resource "aws_secretsmanager_secret_version" "break_glass_password" {
  for_each = local.break_glass_users

  secret_id     = aws_secretsmanager_secret.break_glass_password[each.key].id
  secret_string = aws_iam_user_login_profile.break_glass[each.key].password
}
