# =============================================================================
# Security Org Config Module Tests (modules/security-org-config)
# =============================================================================
# Mandatory scenarios:
#   1. Toggle-Off — every enable_* toggle false => zero resources.
#   2. Default configuration — no inputs at all: all four services default to
#      disabled (secure-by-default) and guardduty_features carries its defaults.
#   3. Custom configuration — all services enabled, custom GuardDuty feature
#      toggles, EUSC partition behaviour.
#   4. Validation failures — invalid security_hub_standards entry.
#
# Additionally covered: the cross-account deployment_targets warning check, and
# the org-wide GuardDuty feature auto-enablement
# (aws_guardduty_organization_configuration_feature) used instead of the
# deprecated datasources block.
#
# NOT covered here by design: the delegated-admin DESIGNATIONS
# (aws_*_organization_admin_account). AWS accepts EnableOrganizationAdminAccount
# only from the management account, so they are resources of
# modules/security and pinned in modules/security/tests/security.tftest.hcl.
#
# Scenarios 5a to 5c cover the standards subscription of
# var.security_hub_standards in the delegated admin account in both notations
# (plain ARN suffix string and object with arn_suffix/enabled) and with Security
# Hub switched off.
#
# Providers used directly by the module: aws (default only, no aliases).
# The cross-account provider for this module is generated by Terragrunt, so
# one mock_provider "aws" covers all provider usage.

mock_provider "aws" {
  override_data {
    target = data.aws_partition.current
    values = {
      partition  = "aws"
      dns_suffix = "amazonaws.com"
    }
  }

  override_data {
    target = data.aws_region.current
    values = {
      region = "us-east-1"
    }
  }
}

# -----------------------------------------------------------------------------
# Scenario 1: Toggle-Off — all services disabled, no resources planned
# -----------------------------------------------------------------------------
run "all_services_disabled" {
  command = plan

  variables {
    enable_guardduty    = false
    enable_security_hub = false
    enable_macie        = false
    enable_detective    = false
  }

  # GuardDuty
  assert {
    condition     = length(aws_guardduty_detector.this) == 0
    error_message = "No GuardDuty detector must be created when disabled."
  }

  assert {
    condition     = length(aws_guardduty_organization_configuration.this) == 0
    error_message = "No GuardDuty org config must be created when disabled."
  }

  assert {
    condition     = length(aws_guardduty_detector_feature.s3_protection) == 0
    error_message = "No GuardDuty S3 protection feature must be created when GuardDuty is disabled."
  }

  assert {
    condition     = length(aws_guardduty_detector_feature.eks_audit_logs) == 0
    error_message = "No GuardDuty EKS audit logs feature must be created when GuardDuty is disabled."
  }

  assert {
    condition     = length(aws_guardduty_detector_feature.eks_runtime_monitoring) == 0
    error_message = "No GuardDuty EKS runtime monitoring feature must be created when GuardDuty is disabled."
  }

  assert {
    condition     = length(aws_guardduty_detector_feature.ebs_malware_protection) == 0
    error_message = "No GuardDuty EBS malware protection feature must be created when GuardDuty is disabled."
  }

  assert {
    condition     = length(aws_guardduty_detector_feature.rds_protection) == 0
    error_message = "No GuardDuty RDS protection feature must be created when GuardDuty is disabled."
  }

  assert {
    condition     = length(aws_guardduty_detector_feature.lambda_protection) == 0
    error_message = "No GuardDuty Lambda protection feature must be created when GuardDuty is disabled."
  }

  # Org-wide feature auto-enablement follows the detector toggle.
  assert {
    condition = alltrue([
      length(aws_guardduty_organization_configuration_feature.this) == 0,
      length(aws_guardduty_organization_configuration_feature.eks_runtime_monitoring) == 0,
    ])
    error_message = "No GuardDuty org-wide feature auto-enablement must be created when GuardDuty is disabled."
  }

  # Security Hub
  assert {
    condition     = length(aws_securityhub_account.this) == 0
    error_message = "No Security Hub account must be created when disabled."
  }

  assert {
    condition     = length(aws_securityhub_organization_configuration.this) == 0
    error_message = "No Security Hub org config must be created when disabled."
  }

  # Macie — the org-admin designation is not a resource of this module
  # (modules/security makes it from the management account), so its absence is
  # pinned in modules/security/tests/security.tftest.hcl.
  assert {
    condition     = length(aws_macie2_account.this) == 0
    error_message = "No Macie account must be created when disabled."
  }

  # Detective — same as Macie: the designation moved to modules/security.
  assert {
    condition     = length(aws_detective_graph.this) == 0
    error_message = "No Detective graph must be created when disabled."
  }

  assert {
    condition     = length(aws_detective_organization_configuration.this) == 0
    error_message = "No Detective org config must be created when disabled."
  }

  # Outputs
  assert {
    condition     = output.guardduty_detector_id == null
    error_message = "guardduty_detector_id must be null when disabled."
  }

  assert {
    condition     = output.guardduty_org_configuration_id == null
    error_message = "guardduty_org_configuration_id must be null when disabled."
  }

  assert {
    condition     = output.security_hub_enabled == false
    error_message = "security_hub_enabled must be false when disabled."
  }

  assert {
    condition     = output.macie_enabled == false
    error_message = "macie_enabled must be false when disabled."
  }

  assert {
    condition     = output.detective_graph_arn == null
    error_message = "detective_graph_arn must be null when disabled."
  }
}

# -----------------------------------------------------------------------------
# Scenario 2: Default configuration — no inputs, every toggle defaults to false
# -----------------------------------------------------------------------------
run "default_configuration" {
  command = plan

  assert {
    condition     = length(aws_guardduty_detector.this) == 0
    error_message = "Module defaults must not enable GuardDuty."
  }

  assert {
    condition     = length(aws_securityhub_account.this) == 0
    error_message = "Module defaults must not enable Security Hub."
  }

  assert {
    condition     = length(aws_macie2_account.this) == 0
    error_message = "Module defaults must not enable Macie."
  }

  assert {
    condition     = length(aws_detective_graph.this) == 0
    error_message = "Module defaults must not enable Detective."
  }

  assert {
    condition     = output.security_hub_enabled == false && output.macie_enabled == false
    error_message = "Module defaults must report all services as disabled."
  }
}

# -----------------------------------------------------------------------------
# Scenario 2b: All services enabled with default GuardDuty feature toggles
# -----------------------------------------------------------------------------
run "all_services_enabled" {
  command = plan

  variables {
    enable_guardduty    = true
    enable_security_hub = true
    enable_macie        = true
    enable_detective    = true
    is_eusc             = false
  }

  # GuardDuty detector + org config
  assert {
    condition     = length(aws_guardduty_detector.this) == 1
    error_message = "GuardDuty detector must be created when enabled."
  }

  assert {
    condition     = length(aws_guardduty_organization_configuration.this) == 1
    error_message = "GuardDuty org config must be created when enabled."
  }

  assert {
    condition     = aws_guardduty_organization_configuration.this[0].auto_enable_organization_members == "ALL"
    error_message = "GuardDuty org config must auto-enable for ALL members."
  }

  # GuardDuty detector features — default toggles
  assert {
    condition     = length(aws_guardduty_detector_feature.s3_protection) == 1
    error_message = "GuardDuty S3 protection feature must be created."
  }

  assert {
    condition     = aws_guardduty_detector_feature.s3_protection[0].status == "ENABLED"
    error_message = "S3 protection must be ENABLED by default."
  }

  assert {
    condition     = length(aws_guardduty_detector_feature.eks_audit_logs) == 1
    error_message = "GuardDuty EKS audit logs feature must be created."
  }

  assert {
    condition     = aws_guardduty_detector_feature.eks_runtime_monitoring[0].status == "DISABLED"
    error_message = "EKS runtime monitoring must be DISABLED by default."
  }

  assert {
    condition     = length(aws_guardduty_detector_feature.ebs_malware_protection) == 1
    error_message = "GuardDuty EBS malware protection feature must be created."
  }

  assert {
    condition     = length(aws_guardduty_detector_feature.rds_protection) == 1
    error_message = "GuardDuty RDS protection feature must be created."
  }

  assert {
    condition     = length(aws_guardduty_detector_feature.lambda_protection) == 1
    error_message = "GuardDuty Lambda protection feature must be created."
  }

  # Org-wide feature auto-enablement: every feature toggle reaches the
  # members, not only the three the deprecated datasources block carries.
  # Default toggles: S3, EKS audit logs, EBS malware, RDS and Lambda on;
  # EKS runtime monitoring and its agent add-on off.
  assert {
    condition = alltrue([
      length(aws_guardduty_organization_configuration_feature.this) == 5,
      aws_guardduty_organization_configuration_feature.this["S3_DATA_EVENTS"].auto_enable == "ALL",
      aws_guardduty_organization_configuration_feature.this["EKS_AUDIT_LOGS"].auto_enable == "ALL",
      aws_guardduty_organization_configuration_feature.this["EBS_MALWARE_PROTECTION"].auto_enable == "ALL",
      aws_guardduty_organization_configuration_feature.this["RDS_LOGIN_EVENTS"].auto_enable == "ALL",
      aws_guardduty_organization_configuration_feature.this["LAMBDA_NETWORK_LOGS"].auto_enable == "ALL",
    ])
    error_message = "With default toggles S3, EKS audit logs, EBS malware, RDS and Lambda protection must be auto-enabled for ALL members."
  }

  assert {
    condition = alltrue([
      length(aws_guardduty_organization_configuration_feature.eks_runtime_monitoring) == 1,
      aws_guardduty_organization_configuration_feature.eks_runtime_monitoring[0].auto_enable == "NONE",
      one(aws_guardduty_organization_configuration_feature.eks_runtime_monitoring[0].additional_configuration).auto_enable == "NONE",
    ])
    error_message = "EKS runtime monitoring and its agent add-on must be NONE for members by default — a disabled feature is carried as NONE, not left unmanaged."
  }

  # Security Hub
  assert {
    condition     = length(aws_securityhub_account.this) == 1
    error_message = "Security Hub account must be created when enabled."
  }

  assert {
    condition     = aws_securityhub_account.this[0].enable_default_standards == false
    error_message = "Security Hub must not enable the default standards implicitly."
  }

  assert {
    condition     = length(aws_securityhub_organization_configuration.this) == 1
    error_message = "Security Hub org config must be created when enabled."
  }

  assert {
    condition     = aws_securityhub_organization_configuration.this[0].auto_enable == true
    error_message = "Security Hub org config must auto-enable for members."
  }

  # Macie — session only. The org-admin designation is made by modules/security
  # from the management account; its presence on the Audit account is
  # pinned in modules/security/tests/security.tftest.hcl.
  assert {
    condition     = length(aws_macie2_account.this) == 1
    error_message = "Macie account must be created when enabled and not EUSC."
  }

  # Detective — graph and member auto-enable; the designation moved likewise.
  assert {
    condition     = length(aws_detective_graph.this) == 1
    error_message = "Detective graph must be created when enabled."
  }

  assert {
    condition     = length(aws_detective_organization_configuration.this) == 1
    error_message = "Detective org config must be created when enabled."
  }

  assert {
    condition     = aws_detective_organization_configuration.this[0].auto_enable == true
    error_message = "Detective org config must auto-enable for members."
  }

  # Outputs
  assert {
    condition     = output.security_hub_enabled == true
    error_message = "security_hub_enabled must be true when enabled."
  }

  assert {
    condition     = output.macie_enabled == true
    error_message = "macie_enabled must be true when enabled and not EUSC."
  }
}

# -----------------------------------------------------------------------------
# Scenario 3: Custom configuration — custom GuardDuty features and standards
# -----------------------------------------------------------------------------
run "custom_configuration" {
  command = plan

  variables {
    enable_guardduty = true
    guardduty_features = {
      s3_protection          = false
      eks_audit_logs         = false
      eks_runtime_monitoring = true
      eks_manage_agent       = true
      ebs_malware_protection = false
      rds_protection         = false
      lambda_protection      = false
    }
    security_hub_standards = [
      "aws-foundational-security-best-practices/v/1.0.0",
      "cis-aws-foundations-benchmark/v/1.4.0",
    ]
  }

  assert {
    condition     = aws_guardduty_detector_feature.s3_protection[0].status == "DISABLED"
    error_message = "S3 protection must follow the custom feature toggle (DISABLED)."
  }

  assert {
    condition     = aws_guardduty_detector_feature.eks_audit_logs[0].status == "DISABLED"
    error_message = "EKS audit logs must follow the custom feature toggle (DISABLED)."
  }

  assert {
    condition     = aws_guardduty_detector_feature.eks_runtime_monitoring[0].status == "ENABLED"
    error_message = "EKS runtime monitoring must follow the custom feature toggle (ENABLED)."
  }

  assert {
    condition     = one(aws_guardduty_detector_feature.eks_runtime_monitoring[0].additional_configuration).status == "ENABLED"
    error_message = "eks_manage_agent must drive the EKS_ADDON_MANAGEMENT additional configuration."
  }

  assert {
    condition     = aws_guardduty_detector_feature.ebs_malware_protection[0].status == "DISABLED"
    error_message = "EBS malware protection must follow the custom feature toggle (DISABLED)."
  }

  assert {
    condition     = aws_guardduty_detector_feature.rds_protection[0].status == "DISABLED"
    error_message = "RDS protection must follow the custom feature toggle (DISABLED)."
  }

  assert {
    condition     = aws_guardduty_detector_feature.lambda_protection[0].status == "DISABLED"
    error_message = "Lambda protection must follow the custom feature toggle (DISABLED)."
  }

  # Org-wide auto-enablement follows the same toggles. The deprecated
  # datasources block is computed in the provider and covers only S3, EKS audit
  # logs and EBS malware, so RDS, Lambda and EKS runtime monitoring need the
  # per-feature resources to reach members.
  assert {
    condition = alltrue([
      aws_guardduty_organization_configuration_feature.this["S3_DATA_EVENTS"].auto_enable == "NONE",
      aws_guardduty_organization_configuration_feature.this["EKS_AUDIT_LOGS"].auto_enable == "NONE",
      aws_guardduty_organization_configuration_feature.this["EBS_MALWARE_PROTECTION"].auto_enable == "NONE",
      aws_guardduty_organization_configuration_feature.this["RDS_LOGIN_EVENTS"].auto_enable == "NONE",
      aws_guardduty_organization_configuration_feature.this["LAMBDA_NETWORK_LOGS"].auto_enable == "NONE",
    ])
    error_message = "Every switched-off feature toggle must reach the members as NONE, not only the three the datasources block carries."
  }

  assert {
    condition = alltrue([
      aws_guardduty_organization_configuration_feature.eks_runtime_monitoring[0].auto_enable == "ALL",
      one(aws_guardduty_organization_configuration_feature.eks_runtime_monitoring[0].additional_configuration).auto_enable == "ALL",
    ])
    error_message = "eks_runtime_monitoring and eks_manage_agent must be auto-enabled for ALL members when the toggles are on."
  }

  # Security Hub stays disabled — no standards resource is created by this module
  assert {
    condition     = length(aws_securityhub_account.this) == 0
    error_message = "Security Hub must stay disabled when its toggle is not set."
  }
}

# -----------------------------------------------------------------------------
# Scenario 3b: EUSC partition — Macie disabled, other services unaffected
# -----------------------------------------------------------------------------
run "eusc_partition_macie_disabled" {
  command = plan

  override_data {
    target = data.aws_partition.current
    values = {
      partition  = "aws-eusc"
      dns_suffix = "amazonaws.eu"
    }
  }

  variables {
    enable_guardduty    = true
    enable_security_hub = true
    enable_macie        = true
    enable_detective    = true
    is_eusc             = true
  }

  # enable_detective = true in aws-eusc trips the availability check by design —
  # the skip must be reported, not silent.
  expect_failures = [
    check.detective_partition_availability,
  ]

  # Macie must NOT be created in EUSC
  assert {
    condition     = length(aws_macie2_account.this) == 0
    error_message = "Macie account must NOT be created in EUSC partition."
  }

  assert {
    condition     = output.macie_enabled == false
    error_message = "macie_enabled must be false in EUSC partition."
  }

  # Detective is not available in aws-eusc either — the same
  # partition gate skips both resources and the graph output reports null.
  assert {
    condition = alltrue([
      length(aws_detective_graph.this) == 0,
      length(aws_detective_organization_configuration.this) == 0,
    ])
    error_message = "Detective must NOT be created in EUSC partition."
  }

  assert {
    condition     = output.detective_graph_arn == null
    error_message = "detective_graph_arn must report null in EUSC partition."
  }

  # Other services must still be created
  assert {
    condition     = length(aws_guardduty_detector.this) == 1
    error_message = "GuardDuty must still be created in EUSC partition."
  }

  assert {
    condition     = length(aws_securityhub_account.this) == 1
    error_message = "Security Hub must still be created in EUSC partition."
  }
}

# -----------------------------------------------------------------------------
# Scenario 3c: guardduty_deployment_targets triggers the cross-account warning
# -----------------------------------------------------------------------------
# The same target list is used by the sister scenario
# regression_guardduty_deployment_targets_are_reported in
# modules/security/tests/security.tftest.hcl. Both modules take the value from
# one loader local, so the equal treatment has to be
# visible in the tests as well: same input, same reported limitation, org-wide
# configuration untouched.
run "guardduty_deployment_targets_warning" {
  command = plan

  variables {
    enable_guardduty             = true
    guardduty_deployment_targets = ["111111111111", "ou-abc1-11111111"]
  }

  expect_failures = [
    check.guardduty_deployment_targets_warning,
  ]

  assert {
    condition     = length(aws_guardduty_detector.this) == 1
    error_message = "GuardDuty must still be configured org-wide from the Audit account."
  }

  assert {
    condition     = aws_guardduty_organization_configuration.this[0].auto_enable_organization_members == "ALL"
    error_message = "Selective deployment targets must not silently narrow the org configuration — it stays ALL and the gap is reported by the check."
  }
}

# -----------------------------------------------------------------------------
# Scenario 5a: Security Hub standards are subscribed (string form)
# -----------------------------------------------------------------------------
# The variable must drive a subscription, not only its own validation. The
# compliance loader also hands over the object form (scenario 5b), which a
# list(string) type would reject before the plan.
run "regression_security_hub_standards_are_subscribed" {
  command = plan

  variables {
    enable_security_hub = true
    security_hub_standards = [
      "aws-foundational-security-best-practices/v/1.0.0",
      "cis-aws-foundations-benchmark/v/1.4.0",
    ]
  }

  assert {
    condition     = length(aws_securityhub_standards_subscription.this) == 2
    error_message = "Every enabled standard must be subscribed in the delegated admin account."
  }

  # The subscriptions are addressed by arn_suffix (for_each), not by a list
  # index — removing one standard must not shift the addresses of the others.
  assert {
    condition     = aws_securityhub_standards_subscription.this["aws-foundational-security-best-practices/v/1.0.0"].standards_arn == "arn:aws:securityhub:us-east-1::standards/aws-foundational-security-best-practices/v/1.0.0"
    error_message = "The standard ARN must be built from the detected partition and region, addressed by its arn_suffix key."
  }

  assert {
    condition     = contains(keys(aws_securityhub_standards_subscription.this), "cis-aws-foundations-benchmark/v/1.4.0")
    error_message = "Each enabled standard must be addressable by its arn_suffix key."
  }
}

# -----------------------------------------------------------------------------
# Scenario 5b: object form, disabled standards stay documentation
# -----------------------------------------------------------------------------
# This is the notation the compliance loader produces
# (local.compliance.locals.security_hub_standards).
run "regression_security_hub_standards_object_form" {
  command = plan

  variables {
    enable_security_hub = true
    security_hub_standards = [
      { arn_suffix = "aws-foundational-security-best-practices/v/1.0.0", enabled = true },
      { arn_suffix = "cis-aws-foundations-benchmark/v/1.2.0", enabled = false },
      { arn_suffix = "nist-800-53/v/5.0.0", enabled = true },
    ]
  }

  assert {
    condition     = length(aws_securityhub_standards_subscription.this) == 2
    error_message = "Only the enabled entries must be subscribed; a disabled entry is documentation only."
  }

  assert {
    condition     = aws_securityhub_standards_subscription.this["nist-800-53/v/5.0.0"].standards_arn == "arn:aws:securityhub:us-east-1::standards/nist-800-53/v/5.0.0"
    error_message = "An enabled standard must be subscribed under its own arn_suffix key, unaffected by a disabled entry before it."
  }

  assert {
    condition     = !contains(keys(aws_securityhub_standards_subscription.this), "cis-aws-foundations-benchmark/v/1.2.0")
    error_message = "A disabled standard must not appear among the subscription keys."
  }
}

# -----------------------------------------------------------------------------
# Scenario 5c: no subscription while Security Hub is off
# -----------------------------------------------------------------------------
run "regression_security_hub_standards_need_the_service" {
  command = plan

  variables {
    enable_security_hub = false
    security_hub_standards = [
      "aws-foundational-security-best-practices/v/1.0.0",
    ]
  }

  assert {
    condition     = length(aws_securityhub_standards_subscription.this) == 0
    error_message = "No standard must be subscribed while Security Hub itself is disabled."
  }

  assert {
    condition     = length(aws_securityhub_account.this) == 0
    error_message = "Security Hub must stay disabled when its toggle is off."
  }
}

# -----------------------------------------------------------------------------
# Scenario 5d: EUSC is detected from the partition alone
# -----------------------------------------------------------------------------
# docs/multi-partition.md promises the decision is derived automatically from
# data.aws_partition.current, not only from var.is_eusc. Here is_eusc is
# deliberately left at its default false: the detected partition alone has to
# skip Macie. Scenario 3b covers the combination of both signals.
run "regression_eusc_detected_without_the_input" {
  command = plan

  override_data {
    target = data.aws_partition.current
    values = {
      partition  = "aws-eusc"
      dns_suffix = "amazonaws.eu"
    }
  }

  variables {
    enable_guardduty    = true
    enable_security_hub = true
    enable_macie        = true
    enable_detective    = true
    is_eusc             = false
  }

  # The detected partition alone must also trip the Detective availability
  # check — the silent skip is exactly what the check exists for.
  expect_failures = [
    check.detective_partition_availability,
  ]

  assert {
    condition     = length(aws_macie2_account.this) == 0
    error_message = "The detected aws-eusc partition alone must skip the Macie activation, without the caller setting is_eusc."
  }

  assert {
    condition     = output.macie_enabled == false
    error_message = "macie_enabled must report the partition-derived state, not the raw input."
  }

  assert {
    condition     = length(aws_detective_graph.this) == 0
    error_message = "The detected aws-eusc partition alone must skip the Detective graph as well."
  }
  assert {
    condition     = length(aws_guardduty_detector.this) == 1 && length(aws_securityhub_account.this) == 1
    error_message = "GuardDuty and Security Hub must stay available — the partition affects only Macie and Detective."
  }
}

# -----------------------------------------------------------------------------
# Scenario 5e: outside EUSC the input still forces the behaviour
# -----------------------------------------------------------------------------
# The derivation is var.is_eusc || partition == "aws-eusc", so an explicit input
# keeps working in the aws partition; this direction keeps the documented input
# from being dropped silently.
run "regression_eusc_input_still_forces_the_skip" {
  command = plan

  variables {
    enable_macie = true
    is_eusc      = true
  }

  assert {
    condition     = length(aws_macie2_account.this) == 0
    error_message = "An explicit is_eusc = true must still skip Macie in the aws partition."
  }
}

# -----------------------------------------------------------------------------
# Scenario 4: Validation failures
# -----------------------------------------------------------------------------
run "empty_security_hub_standard_rejected" {
  command = plan

  variables {
    security_hub_standards = ["aws-foundational-security-best-practices/v/1.0.0", ""]
  }

  expect_failures = [var.security_hub_standards]
}

# -----------------------------------------------------------------------------
# Subscription addresses survive removing an earlier standard
# -----------------------------------------------------------------------------
# With count the removal of the first standard would shift every later
# subscription to a new index — Terraform would destroy and recreate the
# org-wide subscriptions with a coverage gap in between. With for_each the
# remaining standard keeps its arn_suffix address, so this plan is the state a deployment converges to
# without touching the surviving subscription.
run "regression_standards_addresses_survive_removal" {
  command = plan

  variables {
    enable_security_hub = true
    security_hub_standards = [
      # aws-foundational-security-best-practices/v/1.0.0 removed — the
      # remaining standard must keep its own key, not inherit index 0.
      "nist-800-53/v/5.0.0",
    ]
  }

  assert {
    condition     = length(aws_securityhub_standards_subscription.this) == 1
    error_message = "Exactly the remaining standard must be subscribed."
  }

  assert {
    condition     = contains(keys(aws_securityhub_standards_subscription.this), "nist-800-53/v/5.0.0")
    error_message = "The remaining standard must stay addressed by its arn_suffix key after an earlier entry is removed."
  }
}

# -----------------------------------------------------------------------------
# The Detective EUSC skip is reported by this module's own check
# -----------------------------------------------------------------------------
# A deployment that enables Detective solely through this module (the Audit
# stack) must get a warning in aws-eusc, not only the one in modules/security.
run "eusc_detective_skip_is_reported" {
  command = plan

  override_data {
    target = data.aws_partition.current
    values = {
      partition  = "aws-eusc"
      dns_suffix = "amazonaws.eu"
    }
  }

  variables {
    enable_detective = true
  }

  expect_failures = [
    check.detective_partition_availability,
  ]

  assert {
    condition = alltrue([
      length(aws_detective_graph.this) == 0,
      length(aws_detective_organization_configuration.this) == 0,
    ])
    error_message = "Detective resources must be skipped in the aws-eusc partition while the check reports the skip."
  }
}
