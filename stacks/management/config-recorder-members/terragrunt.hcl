# Config Recorder Members — Deploy Config Recorders to member accounts from
# the Management Account using dynamically generated providers. Accounts whose
# recorders are owned by dedicated stacks (stacks/*/config-recorder) are
# excluded, so exactly one state file manages each recorder.
# No Terraform module — all .tf files are generated by Terragrunt.

include "root" {
  path = find_in_parent_folders("root.hcl")
}

locals {
  common   = read_terragrunt_config(find_in_parent_folders("env/common.hcl"))
  accounts = read_terragrunt_config(find_in_parent_folders("env/accounts.hcl"))

  partition    = local.common.locals.partition
  region       = local.common.locals.region
  role_name    = local.common.locals.account_access_role_name
  default_tags = local.common.locals.default_tags
  aws_profile  = local.common.locals.aws_profile

  dns_suffix = {
    "aws"      = "amazonaws.com"
    "aws-eusc" = "amazonaws.eu"
  }

  # Read for the adoption list only (loader local adoption_imports_by_stack).
  compliance = read_terragrunt_config("${get_repo_root()}/configurations/loader.hcl")

  # Accounts whose recorders are owned by dedicated stacks: every
  # <dir>/config-recorder unit under stacks/ (audit, log-archive, workload-*)
  # deploys modules/config-recorder-member into one account of its own. The
  # exclusion set is derived from those directories, so adding a workload
  # sidecar removes its account from this loop without an edit here.
  # Directory name → account name follows the sidecar contract in
  # stacks/*/config-recorder/cross_account.hcl ("log-archive" → "Log-Archive").
  # Terragrunt locals cannot reference dependency outputs, so each generate
  # block below applies this set inline: it loops over the active accounts
  # minus this set — never two state files managing the same recorder.
  dedicated_recorder_accounts = [
    for path in fileset("${get_repo_root()}/stacks", "*/config-recorder/terragrunt.hcl") :
    join("-", [for part in split("-", dirname(dirname(path))) : title(part)])
  ]
}

# Resource adoption: declarative import blocks rendered from the adoption
# list (configurations/base/resource-adoptions.json). One import block per
# entry of this stack — e.g. an existing member recorder into
# aws_config_configuration_recorder.acct_<account_id>; an empty adoption list
# renders no blocks and leaves the plan unchanged.
generate "imports" {
  path      = "adoption-imports.tf"
  if_exists = "overwrite_terragrunt"
  contents = lookup(
    local.compliance.locals.adoption_imports_by_stack,
    "management/config-recorder-members",
    "# No adoption entries for this stack (configurations/base/resource-adoptions.json).\n",
  )
}

exclude {
  if      = !local.common.locals.enable_config_recorder_members
  actions = ["all"]
}

dependency "accounts" {
  config_path = "../accounts"

  mock_outputs = {
    active_account_ids = {}
  }
  mock_outputs_allowed_terraform_commands = ["init", "validate", "plan"]
}

dependency "logging" {
  config_path = "../logging"

  mock_outputs = {
    central_log_bucket_name = ""
  }
  mock_outputs_allowed_terraform_commands = ["init", "validate", "plan"]
}

generate "providers" {
  path      = "providers.tf"
  if_exists = "overwrite_terragrunt"

  contents = join("\n\n", [for name, id in { for n, i in dependency.accounts.outputs.active_account_ids : n => i if !contains(local.dedicated_recorder_accounts, n) } :
    <<-EOF
    # ${name}
    provider "aws" {
      alias   = "acct_${id}"
      region  = "${local.region}"
      profile = "${local.aws_profile}" != "" ? "${local.aws_profile}" : null

      default_tags {
        tags = ${jsonencode(local.default_tags)}
      }

      assume_role {
        role_arn = "arn:${local.partition}:iam::${id}:role/${local.role_name}"
      }
    }
    EOF
  ])
}

generate "config_recorders" {
  path      = "config_recorders.tf"
  if_exists = "overwrite_terragrunt"

  contents = join("\n\n", [for name, id in { for n, i in dependency.accounts.outputs.active_account_ids : n => i if !contains(local.dedicated_recorder_accounts, n) } :
    <<-EOF
    # ${name}
    resource "aws_config_configuration_recorder" "acct_${id}" {
      provider = aws.acct_${id}
      name     = "tlz-config-recorder"
      role_arn = "arn:${local.partition}:iam::${id}:role/aws-service-role/config.${local.dns_suffix[local.partition]}/AWSServiceRoleForConfig"

      recording_group {
        all_supported                 = true
        include_global_resource_types = true
      }
    }

    resource "aws_config_delivery_channel" "acct_${id}" {
      provider       = aws.acct_${id}
      name           = "tlz-config-delivery"
      s3_bucket_name = "${dependency.logging.outputs.central_log_bucket_name}"
      s3_key_prefix  = "config"
      depends_on     = [aws_config_configuration_recorder.acct_${id}]
    }

    resource "aws_config_configuration_recorder_status" "acct_${id}" {
      provider   = aws.acct_${id}
      name       = aws_config_configuration_recorder.acct_${id}.name
      is_enabled = true
      depends_on = [aws_config_delivery_channel.acct_${id}]
    }
    EOF
  ])
}

generate "outputs" {
  path      = "outputs.tf"
  if_exists = "overwrite_terragrunt"

  contents = <<-EOF
  output "recorder_names" {
    description = "Map of account name to Config Recorder name"
    value = {
      ${join("\n    ", [for name, id in { for n, i in dependency.accounts.outputs.active_account_ids : n => i if !contains(local.dedicated_recorder_accounts, n) } : "\"${name}\" = aws_config_configuration_recorder.acct_${id}.name"])}
    }
  }

  output "delivery_channel_names" {
    description = "Map of account name to Delivery Channel name"
    value = {
      ${join("\n    ", [for name, id in { for n, i in dependency.accounts.outputs.active_account_ids : n => i if !contains(local.dedicated_recorder_accounts, n) } : "\"${name}\" = aws_config_delivery_channel.acct_${id}.name"])}
    }
  }

  output "deployed_account_ids" {
    description = "List of account IDs where Config Recorders were created"
    value = [${join(", ", [for name, id in { for n, i in dependency.accounts.outputs.active_account_ids : n => i if !contains(local.dedicated_recorder_accounts, n) } : "\"${id}\""])}]
  }
  EOF
}
