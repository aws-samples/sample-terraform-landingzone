    "Monthly": {
      "regions": { "@@assign": ["@@region@@"] },
      "rules": {
        "MonthlyBackup": {
          "lifecycle": { "move_to_cold_storage_after_days": { "@@assign": 90 }, "delete_after_days": { "@@assign": 365 } },
          "target_backup_vault_name": { "@@assign": "Default" },
          "schedule_expression": { "@@assign": "cron(0 5 1 * ? *)" }
        }
      },
      "selections": {
        "tags": {
          "MonthlyBackup": {
            "iam_role_arn": { "@@assign": "arn:@@partition@@:iam::$account:role/Backup-Role" },
