{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "${arn_prefix}:logs:*:${master_account_id}:log-group:/aws/lambda/tlz-account-move:*"
    }
  ]
}
