{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyModifySecurityConfig",
      "Effect": "Deny",
      "Action": [
        "guardduty:DeleteDetector",
        "guardduty:UpdateDetector",
        "securityhub:DisableSecurityHub",
        "macie2:DisableMacie",
        "access-analyzer:DeleteAnalyzer"
      ],
      "Resource": "*",
      "Condition": {
        "StringNotLike": {
          "aws:PrincipalArn": ["arn:*:iam::*:role/TLZDeploymentRole", "arn:*:iam::*:role/tlz-*", "arn:*:iam::*:role/AWSControlTowerExecution", "arn:*:iam::*:role/stacksets-exec-*", "arn:*:iam::*:role/OrganizationAccountAccessRole"]
        }
      }
    },
    {
      "Sid": "DenyS3BucketDeletion",
      "Effect": "Deny",
      "Action": ["s3:DeleteBucket", "s3:DeleteBucketPolicy"],
      "Resource": "arn:*:s3:::*",
      "Condition": {
        "StringNotLike": {
          "aws:PrincipalArn": ["arn:*:iam::*:role/TLZDeploymentRole", "arn:*:iam::*:role/tlz-*", "arn:*:iam::*:role/AWSControlTowerExecution", "arn:*:iam::*:role/stacksets-exec-*", "arn:*:iam::*:role/OrganizationAccountAccessRole"]
        }
      }
    }
  ]
}
