{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OrganizationsAccess",
      "Effect": "Allow",
      "Action": [
        "organizations:UpdatePolicy",
        "organizations:DescribePolicy",
        "organizations:AttachPolicy"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CloudWatchLogsAccess",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "${arn_prefix}:logs:*:*:log-group:/aws/lambda/tlz-scp-auto-revert:*"
    },
    {
      "Sid": "DeadLetterQueueAccess",
      "Effect": "Allow",
      "Action": [
        "sqs:SendMessage"
      ],
      "Resource": "${arn_prefix}:sqs:*:*:${dlq_name}"
    }
  ]
}
