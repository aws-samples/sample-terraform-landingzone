{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowELBLogDelivery",
      "Effect": "Allow",
      "Principal": {
        "Service": "logdelivery.elasticloadbalancing.${dns_suffix}"
      },
      "Action": "s3:PutObject",
      "Resource": "${bucket_arn}/*",
      "Condition": {
        "StringEquals": {
          "s3:x-amz-acl": "bucket-owner-full-control",
          "aws:SourceOrgID": "${organization_id}"
        }
      }
    },
    {
      "Sid": "AllowELBLogDeliveryAclCheck",
      "Effect": "Allow",
      "Principal": {
        "Service": "logdelivery.elasticloadbalancing.${dns_suffix}"
      },
      "Action": "s3:GetBucketAcl",
      "Resource": "${bucket_arn}"
    },
    {
      "Sid": "DenyUnencryptedTransport",
      "Effect": "Deny",
      "Principal": {
        "AWS": "*"
      },
      "Action": "s3:*",
      "Resource": [
        "${bucket_arn}",
        "${bucket_arn}/*"
      ],
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "false"
        }
      }
    }
  ]
}
