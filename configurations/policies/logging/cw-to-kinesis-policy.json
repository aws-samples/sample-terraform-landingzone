{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "kinesis:PutRecord",
        "kinesis:PutRecords"
      ],
      "Resource": ["${kinesis_stream_arn}"]
    },
    {
      "Sid": "AllowKMSForEncryptedStream",
      "Effect": "Allow",
      "Action": [
        "kms:GenerateDataKey",
        "kms:Decrypt"
      ],
      "Resource": ["${kms_key_arn}"]
    }
  ]
}
