{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "MalwareScanSettings",
      "Effect": "Allow",
      "Action": [
        "guardduty:GetMalwareScanSettings",
        "guardduty:UpdateMalwareScanSettings"
      ],
      "Resource": "${detector_arn}"
    },
    {
      "Sid": "FunctionLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "${log_group_arn}"
    }
  ]
}
